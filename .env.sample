# Photo Shelf environment variables
#
# This file is a TEMPLATE — copy it to `.env` for local use and fill in values,
# or set these as env vars directly in your deployment (Coolify).
# Real values are never committed (see .gitignore + AGENTS.md).

# ---- Server ----

# Optional basic auth. Auth is OFF unless BOTH are set.
# Serve over HTTPS in production — basic auth sends credentials base64-encoded.
AUTH_USERNAME=
AUTH_PASSWORD=

# Port to listen on (default 3000)
# PORT=3000

# Where photos + the JSON store live (default ./data; Docker sets /data)
# DATA_DIR=data

# ---- Reddit scraper (scripts/reddit-scrape.mjs) ----

# Photo Shelf BASE URL + credentials used when --post-to / --skip-existing
# are not given. The scraper appends /api/photos (POST) and /api/deleted
# (dedupe) itself. No reddit account/credentials are used — the scraper reads
# anonymous feeds only; if OAuth is ever added, the username/password for it
# must also come from here (never from code).
PHOTO_SHELF_URL=
PHOTO_SHELF_AUTH=

# Default comma-separated subreddits when --subreddit is not passed
# SCRAPE_SUBREDDITS=itookapicture,photography
